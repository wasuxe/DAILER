# =============================================================================
# Dailer Backend Environment Configuration
# Copy this file to .env and fill in production secrets before deploying.
# =============================================================================

# Application metadata & Flask server settings
APP_VERSION=1.0.0
SECRET_KEY=yashwasu!@!@
HOST=0.0.0.0
PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# External AI Detection & Speaker Verification APIs
# Leave URLs empty to run in local PLACEHOLDER mode for development/testing.
# Both models can share a single API_KEY (and optional REQ_KEY).
# -----------------------------------------------------------------------------
API_KEY=
REQ_KEY=

ALETHEIA_API_URL=https://platform.detectif.ai/v1/deepfake/detect
EIDOS_API_URL=https://platform.detectif.ai/v1/speakers
# Optional per-model overrides (defaults to API_KEY above if left blank)
ALETHEIA_API_KEY=
EIDOS_API_KEY=

# -----------------------------------------------------------------------------
# Storage & Encryption Settings
# STORAGE_TYPE: "local" (filesystem) or "s3" (AWS S3 / MinIO compatible)
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=./data/storage

# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# S3 settings (required only when STORAGE_TYPE=s3)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=dailer-embeddings
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Audio Processing & Retention Limits
# -----------------------------------------------------------------------------
MAX_AUDIO_DURATION_S=140.0
ENROLLMENT_DURATION_S=30.0
CALL_AUDIO_RETENTION_HOURS=24.0

# -----------------------------------------------------------------------------
# Detection Thresholds
# -----------------------------------------------------------------------------
EIDOS_MATCH_THRESHOLD=0.75
ALETHEIA_HUMAN_THRESHOLD=0.80
